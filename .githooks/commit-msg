#!/usr/bin/env python3
"""
.githooks/commit-msg - Enforce SE.COM commit message formatting standards.

Validates:
  1. Maximum line length <= 80 characters for all lines.
  2. Subject header length <= 72 characters (warning/error).
  3. Presence of structured 'Why:' section with descriptive content.
  4. Presence of structured 'How:' section with descriptive content.
  5. Merge commits are exempt from structured Why/How requirements.
"""

import os
import re
import subprocess
import sys


def get_current_branch() -> str:
    try:
        res = subprocess.run(
            ["git", "symbolic-ref", "--short", "HEAD"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        if res.returncode == 0:
            return res.stdout.strip()
    except Exception:
        pass
    return ""


def is_merge_active() -> bool:
    try:
        res = subprocess.run(
            ["git", "rev-parse", "-q", "--verify", "MERGE_HEAD"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if res.returncode == 0:
            return True
        res_dir = subprocess.run(
            ["git", "rev-parse", "--git-dir"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        if res_dir.returncode == 0:
            git_dir = res_dir.stdout.strip()
            return os.path.isfile(os.path.join(git_dir, "MERGE_HEAD"))
    except Exception:
        pass
    return False


def validate_commit_msg(msg_file_path: str) -> int:
    branch = get_current_branch()
    if branch == "master" and not is_merge_active():
        print("[-] Hook Error: Direct commits to 'master' are prohibited.")
        print("    Agents must develop on feature/dev branches and merge into "
              "master.")
        return 1

    try:
        with open(msg_file_path, "r", encoding="utf-8") as f:
            raw_lines = f.readlines()
    except Exception as e:
        print(f"[-] Hook Error: Unable to read commit message file: {e}")
        return 1

    # Strip trailing newline characters but preserve line structure
    lines = [line.rstrip("\r\n") for line in raw_lines]

    # Filter out pure comment lines generated by git
    non_comment_lines = [
        line for line in lines if not line.strip().startswith("#")
    ]

    # Trim leading and trailing empty lines
    while non_comment_lines and not non_comment_lines[0].strip():
        non_comment_lines.pop(0)
    while non_comment_lines and not non_comment_lines[-1].strip():
        non_comment_lines.pop()

    if not non_comment_lines:
        print("[-] Hook Error: Commit message is empty.")
        return 1

    subject = non_comment_lines[0]

    # Merge commits (e.g. "Merge branch ...") are exempt from Why/How checks
    if subject.startswith("Merge ") or subject.startswith("merge "):
        # Validate line lengths only
        for idx, line in enumerate(non_comment_lines, start=1):
            if len(line) > 80:
                print(f"[-] Hook Error: Line {idx} exceeds 80 characters "
                      f"({len(line)} chars):")
                print(f"    {line}")
                return 1
        return 0

    # 1. Line length check across all non-comment lines
    for idx, line in enumerate(non_comment_lines, start=1):
        if len(line) > 80:
            print(f"[-] Hook Error: Line {idx} exceeds 80 characters "
                  f"({len(line)} chars):")
            print(f"    {line}")
            return 1

    # 2. Subject header length check
    if len(subject) > 72:
        print(f"[-] Hook Error: Commit title exceeds 72 characters "
              f"({len(subject)} chars):")
        print(f"    {subject}")
        return 1

    # 3. Conventional Commit header pattern check
    # e.g. feat(vfs): ..., fix(editor): ..., chore: ...
    header_pattern = r"^[a-z]+(?:\([a-zA-Z0-9_\-\./]+\))?:\s+.+"
    if not re.match(header_pattern, subject):
        print("[-] Hook Error: Commit title does not match conventional "
              "format: <type>(<scope>): <summary>")
        print(f"    Received: '{subject}'")
        return 1

    full_text = "\n".join(non_comment_lines)

    # 4. Check for 'Why:' section
    why_match = re.search(
        r"^[ \t]*(?:Why|WHY):[ \t]*\n([\s\S]*?)(?=^[ \t]*(?:How|HOW):|\Z)",
        full_text,
        re.MULTILINE,
    )
    if not why_match or not why_match.group(1).strip():
        print("[-] Hook Error: Missing or empty 'Why:' section.")
        print_usage_guide()
        return 1

    # 5. Check for 'How:' section
    how_match = re.search(
        r"^[ \t]*(?:How|HOW):[ \t]*\n([\s\S]*?)(?=^[ \t]*(?:Why|WHY):|\Z)",
        full_text,
        re.MULTILINE,
    )
    if not how_match or not how_match.group(1).strip():
        print("[-] Hook Error: Missing or empty 'How:' section.")
        print_usage_guide()
        return 1

    return 0


def print_usage_guide():
    print("\nExpected Commit Message Format (all lines <= 80 chars):")
    print("  <type>(<scope>): <summary> (<= 72 chars)")
    print("")
    print("  Why:")
    print("  - Explain rationale, background, or user issue addressed")
    print("")
    print("  How:")
    print("  - List concrete implementation changes and routines modified")
    print("")


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: commit-msg <path_to_commit_msg_file>")
        sys.exit(1)
    sys.exit(validate_commit_msg(sys.argv[1]))
