#!/usr/bin/env python3
"""
.githooks/commit-msg - Enforce SE.COM commit message formatting standards.

Validates:
  1. Maximum line length <= 80 characters for all lines.
  2. Subject header length <= 72 characters.
  3. Conventional commit header format <type>(<scope>): <summary>.
  4. Presence of structured 'Why:' section with descriptive content.
  5. Presence of structured 'How:' section with descriptive content.
  6. Compact list formatting (no double-spaced items or orphan lines).
  7. Section header spacing (no blank line immediately following Why/How).
  8. Merge commits are exempt from structured Why/How requirements.
"""

import os
import re
import subprocess
import sys


def get_current_branch() -> str:
    try:
        res = subprocess.run(
            ["git", "symbolic-ref", "--short", "HEAD"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        if res.returncode == 0:
            return res.stdout.strip()
    except Exception:
        pass
    return ""


def is_merge_active() -> bool:
    try:
        res = subprocess.run(
            ["git", "rev-parse", "-q", "--verify", "MERGE_HEAD"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if res.returncode == 0:
            return True
        res_dir = subprocess.run(
            ["git", "rev-parse", "--git-dir"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        if res_dir.returncode == 0:
            git_dir = res_dir.stdout.strip()
            return os.path.isfile(os.path.join(git_dir, "MERGE_HEAD"))
    except Exception:
        pass
    return False


def validate_commit_msg(msg_file_path: str) -> int:
    branch = get_current_branch()
    if branch == "master" and not is_merge_active():
        print("[-] Hook Error: Direct commits to 'master' are prohibited.")
        print("    Agents must develop on feature/dev branches and merge into "
              "master.")
        return 1

    try:
        with open(msg_file_path, "r", encoding="utf-8") as f:
            raw_lines = f.readlines()
    except Exception as e:
        print(f"[-] Hook Error: Unable to read commit message file: {e}")
        return 1

    # Strip trailing newline characters but preserve line structure
    lines = [line.rstrip("\r\n") for line in raw_lines]

    # Filter out pure comment lines generated by git
    non_comment_lines = [
        line for line in lines if not line.strip().startswith("#")
    ]

    # Trim leading and trailing empty lines
    while non_comment_lines and not non_comment_lines[0].strip():
        non_comment_lines.pop(0)
    while non_comment_lines and not non_comment_lines[-1].strip():
        non_comment_lines.pop()

    if not non_comment_lines:
        print("[-] Hook Error: Commit message is empty.")
        return 1

    subject = non_comment_lines[0]

    # Merge commits (e.g. "Merge branch ...") are exempt from Why/How checks
    if subject.startswith("Merge ") or subject.startswith("merge "):
        # Validate line lengths only
        for idx, line in enumerate(non_comment_lines, start=1):
            if len(line) > 80:
                print(f"[-] Hook Error: Line {idx} exceeds 80 characters "
                      f"({len(line)} chars):")
                print(f"    {line}")
                return 1
        return 0

    # 1. Line length check across all non-comment lines
    for idx, line in enumerate(non_comment_lines, start=1):
        if len(line) > 80:
            print(f"[-] Hook Error: Line {idx} exceeds 80 characters "
                  f"({len(line)} chars):")
            print(f"    {line}")
            return 1

    # 2. Subject header length check
    if len(subject) > 72:
        print(f"[-] Hook Error: Commit title exceeds 72 characters "
              f"({len(subject)} chars):")
        print(f"    {subject}")
        return 1

    # 3. Conventional Commit header pattern check
    # e.g. feat(vfs): ..., fix(editor): ..., chore: ...
    header_pattern = r"^[a-z]+(?:\([a-zA-Z0-9_\-\./]+\))?:\s+.+"
    if not re.match(header_pattern, subject):
        print("[-] Hook Error: Commit title does not match conventional "
              "format: <type>(<scope>): <summary>")
        print(f"    Received: '{subject}'")
        return 1

    # 4. Blank line after subject header
    if len(non_comment_lines) > 1 and non_comment_lines[1].strip() != "":
        print("[-] Hook Error: Line 2 must be an empty blank line separating "
              "subject from body.")
        return 1

    # 5. Consecutive blank lines check
    for idx in range(len(non_comment_lines) - 1):
        if (not non_comment_lines[idx].strip()
                and not non_comment_lines[idx + 1].strip()):
            print(f"[-] Hook Error: Multiple consecutive blank lines at "
                  f"line {idx + 2}.")
            print("    Use at most a single blank line between sections.")
            return 1

    # 6. Section header spacing and list styling checks
    for idx, line in enumerate(non_comment_lines):
        clean = line.strip()
        # Ensure no blank line immediately following section header
        if clean in ("Why:", "WHY:", "How:", "HOW:"):
            if (idx + 1 < len(non_comment_lines)
                    and not non_comment_lines[idx + 1].strip()):
                print(f"[-] Hook Error: Empty blank line immediately "
                      f"following '{clean}' on line {idx + 2}.")
                print("    Content must begin immediately on the next line "
                      "(compact spacing).")
                return 1
            if (clean in ("How:", "HOW:")
                    and idx > 0
                    and non_comment_lines[idx - 1].strip()):
                print(f"[-] Hook Error: Missing blank line before '{clean}' "
                      f"on line {idx + 1}.")
                print("    Sections must be separated by exactly one "
                      "blank line.")
                return 1

        # Check for orphan continuation lines separated by a blank line
        if not clean and idx + 1 < len(non_comment_lines):
            next_line = non_comment_lines[idx + 1]
            if (next_line.startswith("  ")
                    and not next_line.lstrip().startswith(("- ", "* ", "+ "))
                    and not re.match(r"^\d+\.\s+", next_line.lstrip())):
                if idx > 0 and non_comment_lines[idx - 1].strip():
                    print(f"[-] Hook Error: Orphan continuation line on line "
                          f"{idx + 2} separated by blank line {idx + 1}:")
                    print(f"    {next_line}")
                    print("    Wrapped continuation lines must not be "
                          "separated by blank lines.")
                    return 1

        # Check for double-spaced bullet lists
        if idx + 2 < len(non_comment_lines):
            prev_line = non_comment_lines[idx].strip()
            mid_line = non_comment_lines[idx + 1].strip()
            next_line = non_comment_lines[idx + 2].strip()
            is_prev = (prev_line.startswith(("- ", "* "))
                       or bool(re.match(r"^\d+\.\s+", prev_line)))
            is_next = (next_line.startswith(("- ", "* "))
                       or bool(re.match(r"^\d+\.\s+", next_line)))
            if is_prev and not mid_line and is_next:
                print(f"[-] Hook Error: Double-spaced list item detected "
                      f"at line {idx + 3}:")
                print(f"    {next_line}")
                print("    Lists must be compact (single-spaced). Do not "
                      "insert blank lines between items.")
                return 1

    full_text = "\n".join(non_comment_lines)

    # 7. Check for 'Why:' section
    why_match = re.search(
        r"^[ \t]*(?:Why|WHY):[ \t]*\n([\s\S]*?)(?=^[ \t]*(?:How|HOW):|\Z)",
        full_text,
        re.MULTILINE,
    )
    if not why_match or not why_match.group(1).strip():
        print("[-] Hook Error: Missing or empty 'Why:' section.")
        print_usage_guide()
        return 1

    # 8. Check for 'How:' section
    how_match = re.search(
        r"^[ \t]*(?:How|HOW):[ \t]*\n([\s\S]*?)(?=^[ \t]*(?:Why|WHY):|\Z)",
        full_text,
        re.MULTILINE,
    )
    if not how_match or not how_match.group(1).strip():
        print("[-] Hook Error: Missing or empty 'How:' section.")
        print_usage_guide()
        return 1

    return 0


def print_usage_guide():
    print("\nExpected Commit Message Format (all lines <= 80 chars):")
    print("  <type>(<scope>): <summary> (<= 72 chars)")
    print("")
    print("  Why:")
    print("  - Explain rationale, background, or user issue addressed")
    print("    (indent wrapped lines with 2 spaces, no blank lines between)")
    print("  - Single-spaced bullet items (no blank lines between bullets)")
    print("")
    print("  How:")
    print("  - List concrete implementation changes and routines modified")
    print("")


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: commit-msg <path_to_commit_msg_file>")
        sys.exit(1)
    sys.exit(validate_commit_msg(sys.argv[1]))
