#!/usr/bin/env python3
"""
Executable launcher script for native Python SE editor.
"""

import os
import sys

# Add ports/python package directory to sys.path
script_dir = os.path.dirname(os.path.abspath(__file__))
pkg_dir = os.path.dirname(script_dir)
if pkg_dir not in sys.path:
    sys.path.insert(0, pkg_dir)

from se.__main__ import main

if __name__ == "__main__":
    main()
